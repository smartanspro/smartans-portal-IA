# Copiá este archivo a ".env" (en la misma carpeta server/) y completá los valores reales.
# ".env" NUNCA se sube al repositorio (ver .gitignore en la raíz).

# ------------------------------------------------------------------
# Entorno
# ------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ------------------------------------------------------------------
# Base de datos y almacenamiento de archivos
# En Railway, montá el volumen persistente en /data y usá esas rutas.
# En desarrollo local, ./data queda dentro del repo (gitignored).
# ------------------------------------------------------------------
DATABASE_PATH=./data/smartans.db
UPLOADS_DIR=./data/uploads

# ------------------------------------------------------------------
# CORS — origen exacto donde corre el frontend (sin barra final)
# ------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------
# Secretos — generá cada uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Nunca reutilices el mismo valor entre secretos distintos.
# ------------------------------------------------------------------
JWT_ACCESS_SECRET=
CSRF_SECRET=
LOGIN_CHALLENGE_SECRET=
PDF_SHARE_TOKEN_SECRET=

# ------------------------------------------------------------------
# Política de sesión y de links de PDF compartidos
# ------------------------------------------------------------------
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
PDF_SHARE_TTL_MINUTES=60

# ------------------------------------------------------------------
# Rate limiting de login
# ------------------------------------------------------------------
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MIN=15

# ------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------
LOG_LEVEL=info
